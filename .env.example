# Adresse MongoDB Atlas : remplacez UTILISATEUR, MOT_DE_PASSE et CLUSTER. Utilisez une base dédiée à la boutique (ici « artech »).
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@CLUSTER.mongodb.net/artech?retryWrites=true&w=majority
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-long-et-unique
SESSION_SECRET=remplacer-par-une-cle-aleatoire-de-64-caracteres
# Adresse publique du site, pour Google et les aperçus de partage (ex. https://www.artech-solutions.com)
NEXT_PUBLIC_SITE_URL=
# Délai (heures) avant l'annulation automatique d'une commande ni confirmée ni payée. 0 = désactivé.
ORDER_EXPIRY_HOURS=48
